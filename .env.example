# =============================================================================
# AI Support Bot Platform — environment variables template
# Copy this file to .env and fill in real values. Never commit .env to git.
# =============================================================================

# --- Platform ---
# Which messaging platform to run. Currently only "discord" is implemented.
BOT_PLATFORM=discord

# --- Discord ---
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# --- LLM Provider ---
# "anthropic"         → Claude API (production)
# "openai_compatible" → xAI Grok or standard OpenAI (testing / free tokens)
LLM_PROVIDER=anthropic

# API key for the selected provider
LLM_API_KEY=your_api_key_here

# Model to use. Claude options: claude-sonnet-4-6 | claude-opus-4-8 | claude-haiku-4-5-20251001
LLM_MODEL=claude-sonnet-4-6

# Base URL — only required when LLM_PROVIDER=openai_compatible
# xAI Grok:  https://api.x.ai/v1
# OpenAI:    https://api.openai.com/v1
# LLM_BASE_URL=https://api.x.ai/v1

# --- Ticket Behaviour ---
# Seconds to wait after the last customer message before the bot responds
TICKET_DEBOUNCE_SECONDS=150

# id категории с тикет-каналами клиентов - Discord: ПКМ по категории ->
# "Copy Category ID" (нужен Developer Mode: User Settings -> Advanced -> Developer Mode).
# Не имя категории: имя ненадёжно (может совпасть с другой категорией), id уникален.
TICKETS_CATEGORY_ID=your_tickets_category_id_here

# --- Order Records (Milestone 5) ---
# id канала с записями о заказах (один пост = один заказ).
# Это НЕ категория тикетов, а конкретный канал - Discord: ПКМ по каналу ->
# "Copy Channel ID" (нужен Developer Mode: User Settings -> Advanced -> Developer Mode).
ORDER_RECORDS_CHANNEL_ID=your_channel_id_here

# PayPal-адрес магазина - отдаётся клиенту при намерении купить товар (BUY_PRODUCT)
STORE_PAYPAL_EMAIL=store@example.com

# --- PostgreSQL (Milestone 6) ---
# DB_HOST=postgres - имя сервиса в docker-compose (backend ходит к БД по имени
# сервиса внутри docker-сети, не по localhost). Для запуска backend вне
# Docker (напрямую на хосте) поставь DB_HOST=localhost.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=support_platform
DB_USER=user
DB_PASSWORD=password

# --- Future: Redis ---
# REDIS_URL=redis://localhost:6379/0
