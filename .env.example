# =============================================================================
# AI Support Bot Platform — environment variables template
# Copy this file to .env and fill in real values. Never commit .env to git.
# =============================================================================

# --- Platform ---
# Which messaging platform to run. Currently only "discord" is implemented.
BOT_PLATFORM=discord

# --- Discord ---
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# --- LLM Provider ---
# "anthropic"         → Claude API (production)
# "openai_compatible" → xAI Grok or standard OpenAI (testing / free tokens)
LLM_PROVIDER=anthropic

# API key for the selected provider
LLM_API_KEY=your_api_key_here

# Model to use. Claude options: claude-sonnet-4-6 | claude-opus-4-8 | claude-haiku-4-5-20251001
LLM_MODEL=claude-sonnet-4-6

# Base URL — only required when LLM_PROVIDER=openai_compatible
# xAI Grok:  https://api.x.ai/v1
# OpenAI:    https://api.openai.com/v1
# LLM_BASE_URL=https://api.x.ai/v1

# --- Ticket Behaviour ---
# Seconds to wait after the last customer message before the bot responds
TICKET_DEBOUNCE_SECONDS=150

# Id of the category holding customer ticket channels - Discord: right-click
# the category -> "Copy Category ID" (requires Developer Mode: User Settings
# -> Advanced -> Developer Mode). Not the category name - names aren't
# unique, ids are.
TICKETS_CATEGORY_ID=your_tickets_category_id_here

# --- Order Records ---
# Id of the channel holding order records (one post = one order). Not the
# ticket category - a specific channel - Discord: right-click the channel ->
# "Copy Channel ID" (requires Developer Mode).
ORDER_RECORDS_CHANNEL_ID=your_channel_id_here

# Store's PayPal address, sent to the customer on intent=BUY_PRODUCT
STORE_PAYPAL_EMAIL=store@example.com

# --- Ticket Panel ---
# Id of the channel where the "Create Ticket" button message is posted.
SUPPORT_CHANNEL_ID=your_support_channel_id_here
# Id of the role granted access to every new ticket channel, alongside its
# creator - Discord: Server Settings -> Roles -> right-click the role ->
# "Copy Role ID".
MODERATOR_ROLE_ID=your_staff_role_id_here

# --- PostgreSQL ---
# DB_HOST=postgres is the docker-compose service name (backend reaches the
# database by service name inside the Docker network, not localhost). Set
# DB_HOST=localhost if running backend outside Docker directly.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=support_platform
DB_USER=user
DB_PASSWORD=password
